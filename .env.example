NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
CHATGPT_ACTIONS_API_KEY=replace-with-a-long-random-secret
RFPMANAGER_API_BASE_URL=https://rfpmanager.vercel.app
TELEGRAM_BOT_TOKEN=from-botfather
# Required: the webhook rejects every update without it. Telegram allows only A-Z a-z 0-9 _ - (max 256).
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Required: group chat IDs the bot answers in (comma separated). Members of these groups can also DM the bot.
# Mention the bot in a group that isn't listed and it replies with that group's chat ID.
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
OPENAI_API_KEY=sk-...
# OPENAI_MODEL defaults to gpt-6-luna; set only to override.
